# ===========================================
# 多语言 wrapper 路由 301 重定向到中文版
# 原因：[locale]/ 下的 /ja /ko 页面未真正翻译，
#     返回中文内容造成重复内容，触发 Google 降权。
#     301 永久重定向把所有信号（PageRank/外链/抓取预算）合并到中文版。
# 注意：/en/ 已有独立英文版内容（教外国人学中文），不再重定向。
# ===========================================

# 单条精确重定向（顶层页面）- 仅 ja/ko
/ja                  https://www.skillxm.cn/                  301
/ko                  https://www.skillxm.cn/                  301
/ja/                 https://www.skillxm.cn/                  301
/ko/                 https://www.skillxm.cn/                  301

# 多路径子目录通配重定向 - 仅 ja/ko
# /ja/blog/xxx → /blog/xxx
# /ko/tools/xxx → /tools/xxx
# 注意：splats 语法是 /* 而非 /:splat（Cloudflare Pages 规范）
/ja/*                /:splat                              301
/ko/*                /:splat                              301

# /zh 是默认语言，等同于 / ；为避免双内容也做 301
/zh/                 https://www.skillxm.cn/                  301
/zh                  https://www.skillxm.cn/                  301

# ===========================================
# /en/ 重复 wrapper 页面 301 重定向到中文版
# 原因：[locale] wrapper 为 /en/ 生成了所有中文页面的翻译版，
#       这些是重复内容。postbuild 脚本会删除这些 HTML 文件，
#       此处添加 301 重定向确保访问时跳转到中文版而非 404。
# 保留的 8 个独立英文页面不会被重定向（静态文件优先于 _redirects）。
# ===========================================
/en/blog/*           /blog/:splat                         301
/en/about/           /about/                               301
/en/contact/         /contact/                             301
